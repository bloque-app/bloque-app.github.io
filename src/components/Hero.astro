---
// Replaces Starlight's Hero (used only by the home page, the one page with `hero` set). Title,
// tagline and actions come from the page's frontmatter as usual; `kicker` is the field
// src/content.config.ts adds. The panel shows the family's marks, on ink in both themes.
import { withBase } from '../lib/url';
import Mark from './Mark.astro';
import { projects } from '../data/projects';

// Starlight's own id for the page title (its skip link and ToC point at it).
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const { kicker } = data as typeof data & { kicker?: string };
---

<section class="bq-hero not-content" aria-labelledby={PAGE_TITLE_ID}>
	<div class="copy">
		{kicker && <p class="kicker">{kicker}</p>}
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ link, text, variant }) => (
						<a class:list={['btn', variant === 'primary' ? 'primary' : 'secondary']} href={withBase(link)}>
							{text}
						</a>
					))}
				</div>
			)
		}
	</div>
	<ul class="family" aria-label="The family">
		{
			projects.map((p) => (
				<li>
					<a href={`#${p.id}`}>
						<Mark product={p.id} size={56} ground="ink" />
						<span class="name">
							{p.id}
							<span class="stop">.</span>
						</span>
						<span class="role">{p.role}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.bq-hero {
		/* Always ink, in both themes. */
		--ink: #0d0c17;
		--ink-surface: #17152a;
		--ink-border: #2a2838;
		--on-ink: #e9e6f2;
		--on-ink-2: #9a96ad;
		--lilac: #a78bfa;

		display: grid;
		gap: 2rem;
		margin-block: 1rem 3rem;
		padding: clamp(1.5rem, 4vw, 3.5rem);
		border: 1px solid var(--ink-border); /* visible edge when the page is ink too */
		border-radius: var(--bq-radius-card);
		background: var(--ink);
		color: var(--on-ink);
	}
	@media (min-width: 64rem) {
		.bq-hero {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			align-items: center;
			gap: 3rem;
		}
	}
	.kicker {
		margin: 0 0 1rem;
		display: inline-block;
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--ink-border);
		border-radius: var(--bq-radius-pill);
		font-size: var(--sl-text-xs);
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--lilac);
	}
	h1 {
		margin: 0;
		font-family: var(--bq-font-display);
		font-weight: 700;
		font-size: clamp(2.25rem, 5vw, 3.75rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
		color: #fbfaff;
		text-wrap: balance;
	}
	.tagline {
		margin: 1.25rem 0 0;
		max-width: 34rem;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: var(--on-ink);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.35rem;
		border-radius: var(--bq-radius-pill);
		font-weight: 500;
		text-decoration: none;
		line-height: 1.2;
	}
	.btn.primary {
		background: #6a3cff;
		color: #ffffff; /* 5.7:1 */
	}
	.btn.primary:hover {
		background: #5a2ef0;
	}
	.btn.secondary {
		border: 1px solid #38354a;
		color: var(--on-ink);
	}
	.btn.secondary:hover {
		border-color: var(--lilac);
		color: #fbfaff;
	}
	.btn:focus-visible,
	.family a:focus-visible {
		outline: 2px solid var(--lilac);
		outline-offset: 2px;
	}
	.family {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.family a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		height: 100%;
		padding: 1.25rem;
		border: 1px solid var(--ink-border);
		border-radius: var(--bq-radius-field);
		background: var(--ink-surface);
		color: inherit;
		text-decoration: none;
	}
	.family a:hover {
		border-color: #38354a;
	}
	.family :global(.bq-mark) {
		margin-bottom: 0.65rem;
	}
	.name {
		font-family: var(--bq-font-display);
		font-weight: 700;
		font-size: var(--sl-text-xl);
		letter-spacing: -0.045em;
		line-height: 1;
		color: #ffffff;
	}
	.stop {
		color: var(--lilac);
	}
	.role {
		font-size: var(--sl-text-sm);
		color: var(--on-ink-2); /* 6.2:1 on ink surface */
	}
</style>
